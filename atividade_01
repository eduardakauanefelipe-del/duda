-- ATIVIDADE PORTAL ESCOLAR
CREATE DATABASE portal_escolar;
USE portal_escolar;

CREATE TABLE atividades (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100),
    categoria VARCHAR(50),
    turno VARCHAR(20),
    vagas INT
);

